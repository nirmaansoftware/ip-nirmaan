/* A toy Liberty library for tests: areas and logic functions, no timing.
 * It lets the yosys-liberty synthesis backend map a design for real in CI.
 * It is not a PDK, describes no process, and cannot time anything. */
library(nirmaan_tiny) {
  cell(INV) {
    area: 2;
    pin(A) { direction: input; }
    pin(Y) { direction: output; function: "A'"; }
  }
  cell(BUF) {
    area: 3;
    pin(A) { direction: input; }
    pin(Y) { direction: output; function: "A"; }
  }
  cell(NAND2) {
    area: 4;
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(Y) { direction: output; function: "(A*B)'"; }
  }
  cell(NOR2) {
    area: 4;
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(Y) { direction: output; function: "(A+B)'"; }
  }
  cell(DFF) {
    area: 16;
    ff(IQ, IQN) { clocked_on: CLK; next_state: D; }
    pin(CLK) { direction: input; clock: true; }
    pin(D) { direction: input; }
    pin(Q) { direction: output; function: "IQ"; }
  }
}
